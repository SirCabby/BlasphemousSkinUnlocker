<Project Sdk="Microsoft.NET.Sdk">

  <!--
    To point the build at YOUR install, copy GameDir.local.props.example to
    GameDir.local.props and set <GameDir> there. GameDir.local.props is
    gitignored, so your personal path never gets committed.
  -->
  <Import Project="GameDir.local.props" Condition="Exists('GameDir.local.props')" />

  <PropertyGroup>
    <!-- Game is Unity 2017.4 on Mono CLR 2.0 => plugins MUST target net35 -->
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>BlasSkinUnlocker</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- The VERSION file at the repo root is the only place the mod version is
         written down; `make version 1.2.3` rewrites it. It feeds the assembly
         version here and PluginVersion.Value below (used by [BepInPlugin]). -->
    <VersionFile>$(MSBuildProjectDirectory)/VERSION</VersionFile>
    <Version Condition="Exists('$(VersionFile)')">$([System.IO.File]::ReadAllText('$(VersionFile)').Trim())</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>

    <!-- Default/example install path. Don't edit this — override <GameDir> in
         GameDir.local.props instead (see the comment at the top of this file). -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Blasphemous</GameDir>

    <Managed>$(GameDir)\Blasphemous_Data\Managed</Managed>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <!-- lets the .NET SDK target net35 without VS targeting packs installed -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reflection-only against the game: we resolve the skin (color palette) types by name at runtime,
         so no reference to Assembly-CSharp is needed to build. -->
    <Reference Include="BepInEx">              <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>               <Private>false</Private></Reference>
    <Reference Include="UnityEngine">          <HintPath>$(Managed)\UnityEngine.dll</HintPath>              <Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath>    <Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(Managed)\UnityEngine.IMGUIModule.dll</HintPath>   <Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(Managed)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <!-- If `Input` fails to resolve on build, uncomment the next line: -->
    <!-- <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(Managed)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference> -->
  </ItemGroup>

  <!-- [BepInPlugin] needs a compile-time literal, so mirror VERSION into a generated
       constant instead of hardcoding it a second time in Plugin.cs. (%3B is an
       escaped ';' — WriteLinesToFile would otherwise split the line there.) -->
  <Target Name="GeneratePluginVersion" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <GeneratedVersionFile>$(IntermediateOutputPath)PluginVersion.g.cs</GeneratedVersionFile>
    </PropertyGroup>
    <ItemGroup>
      <PluginVersionLine Include="// &lt;auto-generated /&gt; Generated from the VERSION file — do not edit." />
      <PluginVersionLine Include="namespace BlasSkinUnlocker" />
      <PluginVersionLine Include="{" />
      <PluginVersionLine Include="    internal static class PluginVersion" />
      <PluginVersionLine Include="    {" />
      <PluginVersionLine Include="        public const string Value = &quot;$(Version)&quot;%3B" />
      <PluginVersionLine Include="    }" />
      <PluginVersionLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(GeneratedVersionFile)" Lines="@(PluginVersionLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(GeneratedVersionFile)" />
      <FileWrites Include="$(GeneratedVersionFile)" />
    </ItemGroup>
  </Target>

</Project>
